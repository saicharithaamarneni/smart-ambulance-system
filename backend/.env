# Smart Ambulance Booking System - Backend Environment Configuration

# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/sabs_db

# JWT
JWT_SECRET=sabs_super_secret_jwt_key_2024_change_in_production
JWT_EXPIRES_IN=7d

# Google Gemini AI API
GEMINI_API_KEY=your_gemini_api_key_here

# CORS - Frontend URL
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Socket.IO
SOCKET_CORS_ORIGIN=http://localhost:3000

# Demo GPS Simulation
GPS_SIMULATION_ENABLED=true
GPS_UPDATE_INTERVAL_MS=3000

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/app.log
